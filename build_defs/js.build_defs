# Remotely Please gives tool paths relative to the action root, so they stop
# resolving once a rule changes directory; this pins $NODE (and node's temp dir)
# to absolute paths first.
_NODE_ENV = 'case "$TOOLS_NODE" in /*) NODE="$TOOLS_NODE";; *) NODE="$PWD/$TOOLS_NODE";; esac; export NODE TMPDIR="$PWD/_node_tmp" && mkdir -p "$TMPDIR"'


def _run_tool(script:str):
    return f"$TOOLS_NODE --experimental-strip-types --no-warnings $TOOLS_GEN/{script}"


def pnpm_lock(name:str, lockfile:str, importers:list=["."], registry:str=""):
    """Turns a pnpm lockfile into two subrepos.

    ///<pkg>/<name>_store holds one target per package version that downloads and
    integrity-checks its tarball. ///<pkg>/<name> lays every importer's dependencies
    out as node_modules beside the importer, sharing one store as pnpm does. Its
    package for each importer directory has one public target per direct dependency,
    plus :everything: ///<pkg>/<name>//:vite for ".", and
    ///<pkg>/<name>//packages/ui:react for packages/ui.

    Args:
      name (str): Name of the node_modules subrepo.
      lockfile (str): The pnpm-lock.yaml (lockfile version 9).
      importers (list): The workspace directories, relative to this package, to lay out node_modules for.
      registry (str): Registry to download from when the lockfile names no tarball. Defaults to the NpmRegistry config.
    """
    registry = registry or CONFIG.JS.NPM_REGISTRY
    tools = {"node": [CONFIG.JS.NODE_TOOL], "gen": [CONFIG.JS.GENERATOR_TOOLS]}
    store = f"{name}_store"
    store_gen = build_rule(
        name = tag(name, "store"),
        srcs = [lockfile],
        tools = tools,
        cmd = _run_tool("lock_file_download.ts") + f" --lock $SRCS --registry {registry} --out $OUT",
        outs = [store],
        _subrepo = True,
    )
    subrepo(name = store, dep = store_gen)

    pkg = package_name()
    importer_list = ",".join(importers)
    link_gen = build_rule(
        name = tag(name, "link"),
        srcs = [lockfile],
        tools = tools,
        cmd = " ".join([
            _run_tool("node_modules_link.ts") + f" --lock $SRCS --importers {importer_list}",
            f"--os {CONFIG.OS} --cpu {CONFIG.ARCH} --store ///{pkg}/{store} --out $OUT",
        ]),
        outs = [name],
        _subrepo = True,
    )
    subrepo(name = name, dep = link_gen, package_root = pkg)


def node_genrule(name:str, cmd:str, srcs:list|dict=[], deps:list=[], outs:list=[], env:dict={}, visibility:list=None):
    """A genrule that runs from this package's directory with the configured node as $NODE.

    node_modules comes from deps on the pnpm_lock subrepos, whose outputs land in
    this package's node_modules in the sandbox.
    """
    pkg = package_name()
    return genrule(
        name = name,
        srcs = srcs,
        deps = deps,
        outs = outs,
        env = env,
        tools = {"node": [CONFIG.JS.NODE_TOOL]},
        cmd = f"{_NODE_ENV} && cd {pkg} && {cmd}",
        visibility = visibility,
    )


def vite_build(name:str, srcs:list, deps:list=[], out:str="dist", env:dict={}, visibility:list=None):
    """Runs `vite build` in this package."""
    return node_genrule(
        name = name,
        srcs = srcs,
        deps = deps,
        outs = [out],
        env = env,
        cmd = '"$NODE" node_modules/vite/bin/vite.js build --emptyOutDir --outDir "$OUT"',
        visibility = visibility,
    )


def js_library(name:str, srcs:list=[], deps:list=[], test_only:bool=False, visibility:list=None):
    """Source files and the libraries and npm packages they import.

    Builds see the whole closure through exported_deps, and tests through runtime_deps,
    as Bazel's runfiles would carry it.
    """
    return filegroup(
        name = name,
        srcs = srcs,
        binary = True,
        exported_deps = deps,
        runtime_deps = deps,
        test_only = test_only,
        visibility = visibility,
    )


def vitest_test(name:str, root:str, dir:str, deps:list, config:str="vitest.config.ts", labels:list=[], visibility:list=None):
    """Runs the vitest suites in one folder.

    vitest runs from the workspace root, where its config sits, and --dir limits it
    to this folder's suites. The config is expected to send its JUnit report to
    XML_OUTPUT_FILE and its cache to TEST_TMPDIR, as it would under Bazel.

    Args:
      name (str): Name of the test.
      root (str): The workspace directory vitest runs from, e.g. the pnpm_lock package.
      dir (str): The folder whose suites to run, relative to root.
      deps (list): Libraries holding the suites, the code they import, and the runner's config.
      config (str): The vitest config, relative to root.
    """
    return gentest(
        name = name,
        data = deps,
        test_tools = {"node": [CONFIG.JS.NODE_TOOL]},
        test_cmd = " && ".join([
            _NODE_ENV,
            'export XML_OUTPUT_FILE="$RESULTS_FILE" TEST_TMPDIR="$PWD/_vitest_tmp"',
            'mkdir -p "$TEST_TMPDIR"',
            f"cd {root}",
            f'"$NODE" node_modules/vitest/vitest.mjs run --config={config} --dir={dir}',
        ]),
        labels = labels + ["vitest"],
        visibility = visibility,
    )
